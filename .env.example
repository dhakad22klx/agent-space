GEMINI_API_KEY="Google Gemini API Key"
GEMINI_MODEL="Model ID of Google Gemini Model"

# Create a Google Cloud OAuth client with application type "Desktop app" and
# enable the Gmail API. The client secret stays local and is never sent to the
# model. Run `/verify gmail` after configuring these values.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
MOCK_AGENT_CALL="true" # Set to "true" to mock agent calls, or "false" to make real calls to the model

# Human-in-the-loop settings
# HITL_ENABLED=false means every tool call runs without asking; on means the
# tools listed in agent/human-in-the-loop/hitl_config.yml wait for a human.
HITL_ENABLED="false"
# inmemory needs no Redis configuration; redis shares state across processes.
# state.backend in optional justsay-config.yml overrides this setting.
HITL_STATE_STORE="inmemory"
HITL_STATE_TTL="24h"

# Redis state store (only required when the selected backend is redis)
REDIS_ADDR="host:port"
REDIS_DB="database name"
REDIS_KEY_PREFIX="agent-state"
REDIS_PASSWORD="Redis password"
